{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platformCommit": "enabled",
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prThresholdLimit": 0,
  "branchDecoration": "none",
  "cleanupBrokenVar": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    ":semanticCommits"
  ],
  "timezone": "America/Sao_Paulo",
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "sabschyks"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "groupName": "Non-major updates",
      "schedule": [
        "at any time"
      ]
    },
    {
      "automerge": true,
      "groupName": "TypeScript Definitions",
      "schedule": [
        "at any time"
      ],
      "matchPackageNames": [
        "/^@types//"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "groupName": "Major updates",
      "schedule": [
        "on monday"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": [
      "security"
    ]
  }
}
